<?xml version="1.0" encoding="UTF-8"?>
<!--
  HÓA ĐƠN BÁN HÀNG – GymStore
  Font DejaVu Sans để hiển thị tiếng Việt đúng.
  Query từ report_db (read model: order_facts, order_item_facts).
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="invoice" pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30"
              topMargin="20" bottomMargin="20"
              language="sql">

  <parameter name="ORDER_ID" class="java.lang.Long"/>

  <queryString>
    <![CDATA[
      SELECT
        o.order_number,
        o.user_id,
        o.order_date,
        o.payment_method,
        o.total_amount,
        i.product_name,
        i.quantity,
        i.unit_price,
        i.subtotal
      FROM order_facts o
      JOIN order_item_facts i ON i.order_id = o.order_id
      WHERE o.order_id = $P{ORDER_ID}::VARCHAR
      ORDER BY i.id
    ]]>
  </queryString>

  <field name="order_number" class="java.lang.String"/>
  <field name="user_id" class="java.lang.String"/>
  <field name="order_date" class="java.sql.Timestamp"/>
  <field name="payment_method" class="java.lang.String"/>
  <field name="total_amount" class="java.math.BigDecimal"/>
  <field name="product_name" class="java.lang.String"/>
  <field name="quantity" class="java.lang.Integer"/>
  <field name="unit_price" class="java.math.BigDecimal"/>
  <field name="subtotal" class="java.math.BigDecimal"/>

  <title>
    <band height="90">
      <staticText>
        <reportElement x="0" y="0" width="535" height="40"/>
        <textElement textAlignment="Center" verticalAlignment="Middle">
          <font fontName="DejaVu Sans" size="20" isBold="true"/>
        </textElement>
        <text><![CDATA[GymStore – Hóa đơn bán hàng]]></text>
      </staticText>
      <staticText>
        <reportElement x="0" y="45" width="200" height="20"/>
        <textElement><font fontName="DejaVu Sans" size="11" isBold="true"/></textElement>
        <text><![CDATA[Số hóa đơn:]]></text>
      </staticText>
      <textField>
        <reportElement x="200" y="45" width="335" height="20"/>
        <textElement><font fontName="DejaVu Sans" size="11"/></textElement>
        <textFieldExpression><![CDATA[$F{order_number}]]></textFieldExpression>
      </textField>
      <staticText>
        <reportElement x="0" y="65" width="200" height="20"/>
        <textElement><font fontName="DejaVu Sans" size="11" isBold="true"/></textElement>
        <text><![CDATA[Ngày đặt hàng:]]></text>
      </staticText>
      <textField pattern="dd/MM/yyyy HH:mm">
        <reportElement x="200" y="65" width="335" height="20"/>
        <textElement><font fontName="DejaVu Sans" size="11"/></textElement>
        <textFieldExpression><![CDATA[$F{order_date}]]></textFieldExpression>
      </textField>
    </band>
  </title>

  <columnHeader>
    <band height="30">
      <staticText><reportElement x="0" y="0" width="250" height="30" backcolor="#FF5500" mode="Opaque"/>
        <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="11" isBold="true" forecolor="#FFFFFF"/></textElement>
        <text><![CDATA[ Tên sản phẩm]]></text></staticText>
      <staticText><reportElement x="250" y="0" width="80" height="30" backcolor="#FF5500" mode="Opaque"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="11" isBold="true" forecolor="#FFFFFF"/></textElement>
        <text><![CDATA[Số lượng]]></text></staticText>
      <staticText><reportElement x="330" y="0" width="100" height="30" backcolor="#FF5500" mode="Opaque"/>
        <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="11" isBold="true" forecolor="#FFFFFF"/></textElement>
        <text><![CDATA[Đơn giá (₫) ]]></text></staticText>
      <staticText><reportElement x="430" y="0" width="105" height="30" backcolor="#FF5500" mode="Opaque"/>
        <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="11" isBold="true" forecolor="#FFFFFF"/></textElement>
        <text><![CDATA[Thành tiền (₫) ]]></text></staticText>
    </band>
  </columnHeader>

  <detail>
    <band height="25">
      <textField><reportElement x="0" y="0" width="250" height="25"/>
        <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="10"/></textElement>
        <textFieldExpression><![CDATA[" " + $F{product_name}]]></textFieldExpression></textField>
      <textField><reportElement x="250" y="0" width="80" height="25"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="10"/></textElement>
        <textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression></textField>
      <textField pattern="#,##0"><reportElement x="330" y="0" width="100" height="25"/>
        <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="10"/></textElement>
        <textFieldExpression><![CDATA[$F{unit_price}]]></textFieldExpression></textField>
      <textField pattern="#,##0"><reportElement x="430" y="0" width="105" height="25"/>
        <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="10"/></textElement>
        <textFieldExpression><![CDATA[$F{subtotal}]]></textFieldExpression></textField>
    </band>
  </detail>

  <summary>
    <band height="50">
      <staticText><reportElement x="330" y="10" width="100" height="30"/>
        <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="13" isBold="true"/></textElement>
        <text><![CDATA[Tổng cộng:]]></text></staticText>
      <textField pattern="#,##0 ₫"><reportElement x="430" y="10" width="105" height="30"/>
        <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="13" isBold="true" forecolor="#FF5500"/></textElement>
        <textFieldExpression><![CDATA[$F{total_amount}]]></textFieldExpression></textField>
    </band>
  </summary>
</jasperReport>
