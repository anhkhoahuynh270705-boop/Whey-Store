<?xml version="1.0" encoding="UTF-8"?>
<!-- Module dùng chung: DTO/exception/sự kiện Kafka chia sẻ giữa các service.
     Giữ phụ thuộc tối thiểu (lombok + jackson + validation) để không kéo nặng. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gymstore</groupId>
        <artifactId>gymstore-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>gymstore-common</artifactId>
    <name>GymStore Common</name>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <!-- Dùng chung PageResponse.from(Page) -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-commons</artifactId>
        </dependency>
        <!-- Bảo mật trung lập web: Jwt, JwtAuthenticationConverter, GrantedAuthority -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
    </dependencies>
</project>
